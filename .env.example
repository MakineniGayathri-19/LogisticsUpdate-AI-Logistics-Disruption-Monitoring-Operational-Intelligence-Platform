# ==============================================================================
# LogisticsUpdate AI – Environment Configuration
# ==============================================================================

# Application Runtime Mode: 'live' or 'demo'
APP_MODE=demo

# Web Scraping Service: Firecrawl API Key
# Sign up at https://www.firecrawl.dev to obtain an API key.
FIRECRAWL_API_KEY=

# Generative AI Provider Selection: 'openai' or 'gemini'
LLM_PROVIDER=openai

# LLM Provider Keys
OPENAI_API_KEY=
# If using Google Gemini instead of OpenAI:
GEMINI_API_KEY=

# Historical Memory Provider: Memento
# If unset, the application automatically uses the Local Memento Adapter.
MEMENTO_API_KEY=
MEMENTO_API_URL=https://api.memento.ai/v1

# Backend Database URL (SQLite default)
DATABASE_URL=sqlite:///./database/app.db

# Backend API Base URL for Frontend Communication
API_BASE_URL=http://127.0.0.1:8000/api
